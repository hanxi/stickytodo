# Copy this file to .env and fill real values. DO NOT commit .env.
# All variable names must match server/internal/config/config.go exactly.
# ---------------------------------------------------------------------

# Required: single-user credentials (plain text; compared in constant time).
TODO_USERNAME=admin
TODO_PASSWORD=change-me-please

# NOTE: The JWT signing secret is NO LONGER configured via env. On first boot,
# the server generates a 32-byte random hex and persists it to the
# `app_secrets` table inside SQLite (see internal/repository/secret_repo.go).
# Subsequent boots reuse the same value, so issued tokens survive restarts.
# To rotate: delete the `jwt_secret` row (all existing tokens become invalid).

# Optional: port the server listens on inside the container.
TODO_PORT=8080

# Optional: host port mapped to container :8080 (compose only).
TODO_HOST_PORT=8080

# Optional: SQLite data directory. The host path ./data is bind-mounted here.
TODO_DATA_DIR=/data

# Optional: JWT TTL in Go duration format (30m, 12h, 24h). Must be > 0.
TODO_TOKEN_TTL=24h

# Optional: extra verbose logging (GORM info level). Accepts 1/0/true/false/yes/no/on/off.
TODO_VERBOSE=false

# Optional: Gin mode. One of debug / release / test.
TODO_GIN_MODE=release

# Optional: CORS allowlist, comma-separated exact origins. Use "*" to allow all.
# Example: TODO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TODO_CORS_ORIGINS=

# Optional: image tag used by `docker compose build`.
VERSION=dev

# Optional: container timezone.
TZ=Asia/Shanghai
